# Bot do Telegram (crie com @BotFather; descubra o chat id via getUpdates)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Local: SQLite. No Railway: use a referência do Postgres (ex.: ${{Postgres.DATABASE_URL}})
DATABASE_URL=sqlite:///monitor.db

# Interface web: sem ADMIN_PASSWORD a página fica desativada (o monitor segue rodando)
ADMIN_USER=admin
ADMIN_PASSWORD=

# Busca em várias lojas (https://serper.dev) - opcional
SERPER_API_KEY=

# IA para sugerir seletor CSS e filtrar ofertas (https://console.anthropic.com) - opcional
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5

# Opcionais
CHECK_INTERVAL_HOURS=2
ALERT_COOLDOWN_HOURS=24
REQUEST_TIMEOUT_SECONDS=15
LOG_LEVEL=INFO
