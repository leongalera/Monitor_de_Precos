# Bot do Telegram (crie com @BotFather; descubra o chat id via @userinfobot)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Local: SQLite. No Railway: use a referência do Postgres (ex.: ${{Postgres.DATABASE_URL}})
DATABASE_URL=sqlite:///monitor.db

# Opcionais
CHECK_INTERVAL_HOURS=2
ALERT_COOLDOWN_HOURS=24
REQUEST_TIMEOUT_SECONDS=15
LOG_LEVEL=INFO
